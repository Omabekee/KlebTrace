// KlebTrace pipeline settings. Paths are relative to the directory Nextflow is
// launched from (the repository root).

params {
    samples          = 'data/samples.tsv'
    genomes          = 'data/genomes'
    portal_calls     = 'data/portal_calls.tsv'
    manifest         = 'data/genomes_manifest.tsv'
    screen           = 'results/portal_negative_screen.tsv'
    outdir           = 'results/pipeline'

    // Bakta GFF3 files from the Galaxy run, one per assembly (<assembly>.gff3).
    // Set to false to run Bakta locally, which needs the ~40 GB database below.
    bakta_gff3_dir   = 'results/phase2_galaxy/bakta_gff3'
    bakta_db         = 'databases/bakta/db'

    // Small databases, downloaded separately (see nextflow/README.md)
    amrfinder_db     = 'databases/amrfinderplus/2026-05-15.1'
    plasmidfinder_db = 'databases/plasmidfinder'

    kleborate_modules = 'general__species,general__contig_stats,kpsc__mlst,klebsiella__ybst,klebsiella__cbst,klebsiella__abst,klebsiella__smst,klebsiella__rmst,kpsc__virulence_score,klebsiella__rmpa2,klebsiella__peg-344,kpsc__amr,kpsc__resistance_score,kpsc__resistance_class_count,kpsc__resistance_gene_count,kpsc__cipro_prediction,kpsc__wzi,kpsc__kaptive,kpsc__mrk'
}

process {
    cpus   = 2
    memory = '4 GB'
    withName: BAKTA         { cpus = 4; memory = '8 GB' }
    withName: AMRFINDERPLUS { cpus = 4 }
}

profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    laptop {
        // For a laptop with little free disk: Apptainer images already pulled into
        // databases/containers by databases/logs/download.sh, and Kleborate from the
        // existing local conda environment instead of its 1.5 GB container.
        singularity.enabled  = true
        singularity.autoMounts = true
        singularity.cacheDir = "${launchDir}/databases/containers"
        conda.enabled        = true
        process {
            cpus = 2
            withName: KLEBORATE     { container = null; conda = "${System.getenv('HOME')}/miniconda3/envs/kleborate" }
            // With conda enabled for Kleborate, Nextflow would otherwise build conda
            // environments for these two tools instead of using their containers
            withName: AMRFINDERPLUS { cpus = 2; conda = null }
            withName: PLASMIDFINDER { conda = null }
        }
    }
    conda       { conda.enabled = true }
    test {
        // Two genomes, for a quick check: one complete genome and the susceptible control
        params.samples = 'tests/test_data/pipeline_samples.tsv'
        params.outdir  = 'results/pipeline_test'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
